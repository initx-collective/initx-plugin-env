{
  "name": "@initx-plugin/env",
  "type": "module",
  "version": "0.1.5",
  "packageManager": "pnpm@12.10.1",
  "description": "initx plugin to manage env vars and secrets from private GitHub or GitLab repositories",
  "author": "imba97",
  "license": "MIT",
  "homepage": "https://github.com/initx-collective/initx-plugin-env#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:initx-collective/initx-plugin-env.git"
  },
  "bugs": {
    "url": "https://github.com/initx-collective/initx-plugin-env/issues"
  },
  "keywords": [
    "initx",
    "initx-plugin",
    "env",
    "dotenv",
    "secrets",
    "github-actions"
  ],
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "stub": "unbuild --stub",
    "build": "unbuild",
    "release": "bumpp",
    "lint": "eslint --cache",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@initx-plugin/core": "*",
    "@initx-plugin/utils": "*"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "libsodium-wrappers": "^0.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@initx-plugin/core": "^0.4.3",
    "@initx-plugin/utils": "^0.4.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.4",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --cache --fix"
  }
}
